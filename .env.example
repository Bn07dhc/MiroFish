# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# 服务商选择（可选）：openai（默认，OpenAI 兼容）或 anthropic
# 使用 Anthropic（Claude）时设置如下三项即可，无需 LLM_BASE_URL：
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...            # 你的 Anthropic API Key
#   LLM_MODEL_NAME=claude-haiku-4-5-20251001
# LLM_PROVIDER=openai

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 服务运行配置（可选）=====
# DEBUG 模式：本地开发可设为 true 开启热重载与详细错误；生产环境务必保持 false
FLASK_DEBUG=false
# Flask 会话密钥：生产环境务必设置为随机字符串
# SECRET_KEY=please-change-me-to-a-random-string
# 允许跨域访问的前端来源（逗号分隔），生产环境建议限制为具体域名
# 例如：CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=*
# 后端监听地址/端口（默认 0.0.0.0:5001）
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001
# 生产 WSGI(waitress) 线程数
# WAITRESS_THREADS=8