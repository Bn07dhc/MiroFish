# ===== Flask 安全配置 =====
# SECRET_KEY 用于会话签名等。生产环境必须显式设置（DEBUG=False 时未设置会启动失败）
# 推荐生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please_change_me_to_a_long_random_string

# 调试模式。生产环境必须为 False；为 True 会启用交互式调试器并输出完整堆栈
FLASK_DEBUG=False

# CORS 允许的前端来源（逗号分隔）。默认仅允许本地开发端口
# 生产示例：ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# API 密钥（逗号分隔，可配置多个用于轮换/多客户端）
# 配置后，所有 /api/* 请求必须携带 X-API-Key: <key> 或 Authorization: Bearer <key>
# 留空表示开放访问（仅适合本地开发）。生产环境务必设置！
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# 每个客户端（按 API key 或 IP）每分钟最大请求数。0 表示禁用限流
RATE_LIMIT_PER_MINUTE=120

# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here